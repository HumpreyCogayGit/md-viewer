{
  "name": "speculo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"e2e/**/*.js\" \"scripts/**/*.mjs\" \"*.config.js\" security-headers.js public/sw.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"e2e/**/*.js\" \"scripts/**/*.mjs\" \"*.config.js\" security-headers.js public/sw.js",
    "size": "node scripts/check-bundle-size.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run format:check && npm test && npm run build && npm run size",
    "notices": "node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "cronstrue": "^3.39.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.18",
    "fast-xml-parser": "^5.12.1",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "js-beautify": "^2.0.3",
    "json5": "^2.2.3",
    "katex": "^0.19.1",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "papaparse": "^5.7.1",
    "pdfmake": "^0.2.7",
    "punycode": "^2.3.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "smol-toml": "^1.9.1",
    "turndown": "^7.2.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "vite": "^8.0.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "katex": "$katex",
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
